# Generated from src/settings.rs by cargo xtask generate

# Token for the web UI
#RUSTICLONE_ADMIN_TOKEN=

# Update rusticlone and the rustic at each restart
#RUSTICLONE_AUTO_UPDATE=false

# Keep the computer from sleeping while a run goes on
#RUSTICLONE_KEEP_AWAKE=true

# Web UI address
#RUSTICLONE_LISTEN=127.0.0.1:32110

# Token for Prometheus and other monitors, to send as `Authorization: Bearer`
#RUSTICLONE_METRICS_TOKEN=

# Location of the rustic executable
#RUSTICLONE_RUSTIC_BIN=

# Time to wait before stopping an unresponsive rustic command
#RUSTICLONE_STALL_TIMEOUT=1h

# Folder for the database and resource locks
#RUSTICLONE_STATE_DIR=
